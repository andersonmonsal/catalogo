rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── PRODUCTOS ──────────────────────────────────────────
    // Cualquiera puede LEER productos (es un catálogo público)
    // Solo administradores autenticados pueden CREAR/EDITAR/BORRAR
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── CONFIGURACIÓN DE LA TIENDA ─────────────────────────
    // Cualquiera puede LEER la config (nombre, whatsapp, logo, etc.)
    // Solo administradores autenticados pueden MODIFICARLA
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── TODO LO DEMÁS: BLOQUEADO ───────────────────────────
    // Ninguna otra colección es accesible
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
