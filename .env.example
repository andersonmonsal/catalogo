# ============================================================
# SHALITO COSMETICS - Variables de Entorno
# ============================================================
# Copia este archivo como .env y completa los valores.
# Obtén las credenciales de Firebase en: https://console.firebase.google.com
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Número de WhatsApp (formato: código de país + número, sin + ni espacios)
# Ejemplo Colombia: 573001234567
VITE_WHATSAPP_NUMBER=
